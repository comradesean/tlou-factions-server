# Never commit the analysis target itself (copyrighted game data)
*.elf
EBOOT.*
tools/served_content/
research/net1bin/
ref/

# Vendored/cloned external tooling — referenced by URL + commit hash in docs instead
tools/external/
tools/.venv/

# Ghidra project (binary, not diffable) and large raw dumps — keep distilled findings, not raw output
research/ghidra/*.gpr
research/ghidra/*.rep/
research/ghidra/*.lock
research/ghidra/*.lock~
research/disasm/*.asm

# Raw packet captures - unfiltered captures include unrelated machine traffic
# (other apps, general browsing). Keep locally; commit only deliberately-trimmed
# exports containing just the relevant streams, if ever needed.
captures/*.pcap
captures/*.pcapng

# Local server/watcher runtime output (live logs, not research artifacts)
backend/rpcn-run.log
tools/*-run.log
captures/*.log

# OS/editor cruft
.DS_Store
*.swp
__pycache__/

# Generated Kaitai parsers (build artifacts of protos/*.ksy)
protos/*.py

# leaderboard-server stub runtime score store
tools/leaderboard_scores.sqlite

# --- Reverse-engineering scratch dumps (not committed) ---
# Raw Ghidra/objdump decompile + disassembly exports
research/ghidra/*.log
research/ghidra/*.txt
research/disasm/
# Live server run logs and debug logs
*-run.log
tools/*_debug.log
# Stray Ghidra export blobs written to the repo root
/003433d0
/012bc660
/0x00ad33d8

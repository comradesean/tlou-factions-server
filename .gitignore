# Never commit the analysis target itself (copyrighted game data)
*.elf
EBOOT.*

# Vendored/cloned external tooling — referenced by URL + commit hash in docs instead
tools/external/
tools/.venv/

# Ghidra project (binary, not diffable) and large raw dumps — keep distilled findings, not raw output
research/ghidra/*.gpr
research/ghidra/*.rep/
research/ghidra/*.lock
research/ghidra/*.lock~
research/disasm/*.asm

# Raw packet captures - unfiltered captures include unrelated machine traffic
# (other apps, general browsing). Keep locally; commit only deliberately-trimmed
# exports containing just the relevant streams, if ever needed.
captures/*.pcap
captures/*.pcapng

# OS/editor cruft
.DS_Store
*.swp
